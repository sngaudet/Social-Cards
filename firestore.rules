rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function session() {
      let state = get(/databases/$(database)/documents/accountState/$(request.auth.uid)).data;
      return request.auth != null && !state.disabled && !state.deleting
        && state.leaseUntil > request.time && request.auth.token.auth_time >= state.validAfter;
    }
    function verified() { return session() && request.auth.token.email_verified == true
      && get(/databases/$(database)/documents/accountState/$(request.auth.uid)).data.emailVerified == true; }
    function pairId(a, b) { return a < b ? a + "_" + b : b + "_" + a; }
    function relationship(id) { return get(/databases/$(database)/documents/relationships/$(id)).data; }
    function participant(data) { return data.users is list && data.users.size() == 2 && request.auth.uid in data.users; }
    function historyAllowed(id) {
      let relation = relationship(id);
      return relation.status != "blocked" || relation.get("historyReaderUid", relation.get("blockedByUid", "")) == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if session() && request.auth.uid == uid;
      // Onboarding and profile validation run on the server; auth state is never editable here.
      allow write: if false;
      match /devices/{deviceId} { allow read, write: if false; }
    }
    // Historical copies may contain hidden fields. No clients can download them.
    match /publicProfiles/{uid} { allow read, write: if false; }
    match /relationships/{id} {
      allow read: if verified() && participant(resource.data) && historyAllowed(id);
      allow write: if false;
    }
    match /connectionRequests/{id} {
      allow read: if verified() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }
    match /connections/{id} {
      allow read: if verified() && participant(resource.data) && historyAllowed(id);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if verified()
          && participant(get(/databases/$(database)/documents/connections/$(id)).data)
          && historyAllowed(id);
        // All creates go through sendChatMessage's transaction: membership, expiry,
        // block state, bounded schema, server commit timestamp, quota, and idempotency.
        // Denying SDK writes also denies forged/missing times and post-expiry writes.
        allow create, update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
